# Токен бота из BotFather
BOT_TOKEN=8900745185:AAH_0gJlKJGI05I_rwOIujSUjAPa954TdjQ

# URL, где будет открываться Mini App (после деплоя на хостинг)
WEBAPP_URL=https://your-domain.com/webapp

# Telegram ID владельца (тебя) и брата.
# Используются для двух целей: (1) куда слать уведомления о заказах,
# (2) этим двум ID автоматически присваивается роль superuser в Mini App
# (видят ВСЕ заказы, могут подтверждать/отклонять/удалять).
# Как узнать свой ID: напиши боту @userinfobot
OWNER_TELEGRAM_ID=
BROTHER_TELEGRAM_ID=

# Логин и пароль для входа в админ-панель (придумай свои, длинные и уникальные)
ADMIN_LOGIN=change_this_admin_login
ADMIN_PASSWORD=change_this_to_a_very_long_random_password

# Секретный токен для доступа в админ-панель (длинная случайная строка, сгенерируется автоматически при первом запуске — см. generate_admin_secret.js)
ADMIN_SECRET_TOKEN=change_this_to_a_long_random_string

# Секретный ключ для шифрования чувствительных данных (генерируется так же, как ADMIN_SECRET_TOKEN)
ENCRYPTION_KEY=change_this_to_a_long_random_string_32bytes

PORT=3000
